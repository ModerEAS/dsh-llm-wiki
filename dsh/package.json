{
  "name": "dsh-llm-wiki",
  "version": "0.6.3",
  "private": true,
  "description": "LLM Wiki as a native DeepSeek Harness plugin — self-maintaining, Obsidian-compatible knowledge base.",
  "type": "module",
  "main": "./host-index.js",
  "exports": {
    ".": "./host-index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "host-index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dsh.client": {
    "platform": "web",
    "inject": ["slots", "locale", "configForms"],
    "immediately": true
  }
}
